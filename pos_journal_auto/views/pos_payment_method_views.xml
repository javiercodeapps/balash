<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_form_inherit_pos_journal_auto" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos.journal.auto</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="invoice_journal_id"/>
            </field>
        </field>
    </record>

    <record id="view_pos_payment_method_tree_inherit_pos_journal_auto" model="ir.ui.view">
        <field name="name">pos.payment.method.list.inherit.pos.journal.auto</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="invoice_journal_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
